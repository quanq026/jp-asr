<Window x:Class="JapaneseASR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Japanese ASR"
        Height="760"
        Width="860"
        MinHeight="560"
        MinWidth="760"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Chuyển giọng nói tiếng Nhật thành chữ"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Foreground="#172033" />
      <TextBlock Text="Chọn một file audio/video, chọn chế độ, rồi bấm Bắt đầu."
                 Margin="0,6,0,0"
                 FontSize="14"
                 Foreground="#596275" />
    </StackPanel>

    <Border Grid.Row="1"
            BorderBrush="#D8DEE9"
            BorderThickness="1"
            Background="White"
            CornerRadius="8"
            Padding="22">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="File cần nhận dạng" FontWeight="SemiBold" Foreground="#172033" />
            <TextBox x:Name="InputPathTextBox"
                     Margin="0,8,12,0"
                     Height="36"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  x:Name="BrowseInputButton"
                  Width="120"
                  Height="36"
                  Margin="0,26,0,0"
                  Content="Chọn file"
                  Click="BrowseInputButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Thư mục xuất kết quả" FontWeight="SemiBold" Foreground="#172033" />
            <TextBox x:Name="OutputPathTextBox"
                     Margin="0,8,12,0"
                     Height="36"
                     VerticalContentAlignment="Center"
                     IsReadOnly="True"
                     TextWrapping="NoWrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  x:Name="BrowseOutputButton"
                  Width="120"
                  Height="36"
                  Margin="0,26,0,0"
                  Content="Chọn thư mục"
                  Click="BrowseOutputButton_Click" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,22,0,0">
          <TextBlock Text="Chế độ xử lý" FontWeight="SemiBold" Foreground="#172033" />
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <RadioButton x:Name="BalancedModeRadio"
                         Content="Cân bằng"
                         IsChecked="True"
                         GroupName="Mode"
                         FontSize="14"
                         Margin="0,0,26,0" />
            <RadioButton x:Name="AccurateModeRadio"
                         Content="Chính xác"
                         GroupName="Mode"
                         FontSize="14" />
          </StackPanel>
          <TextBlock x:Name="ModeDescriptionText"
                     Margin="0,8,0,0"
                     Text="Cân bằng dùng model small để xử lý nhanh hơn trên máy yếu."
                     Foreground="#596275"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="3"
                Margin="0,22,0,0"
                BorderBrush="#E3E8F0"
                BorderThickness="1"
                Background="#FAFBFC"
                CornerRadius="8"
                Padding="14">
          <StackPanel>
            <CheckBox x:Name="EnableAiCheckBox"
                      Content="Dùng AI sửa nhẹ TXT sau khi nhận dạng"
                      FontWeight="SemiBold"
                      Foreground="#172033"
                      Checked="EnableAiCheckBox_Changed"
                      Unchecked="EnableAiCheckBox_Changed" />
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Provider" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0"
                        Grid.Column="1"
                        x:Name="AiProviderComboBox"
                        Height="32"
                        SelectionChanged="AiProviderComboBox_SelectionChanged">
                <ComboBoxItem Content="Ollama" Tag="Ollama" IsSelected="True" />
                <ComboBoxItem Content="NVIDIA NIM" Tag="NvidiaNim" />
                <ComboBoxItem Content="DeepSeek" Tag="DeepSeek" />
              </ComboBox>

              <TextBlock Grid.Row="0" Grid.Column="2" Margin="14,0,0,0" Text="Model" VerticalAlignment="Center" />
              <TextBox Grid.Row="0"
                       Grid.Column="3"
                       x:Name="AiModelTextBox"
                       Height="32"
                       VerticalContentAlignment="Center"
                       Text="qwen2.5:7b" />

              <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,10,0,0" Text="Endpoint" VerticalAlignment="Center" />
              <TextBox Grid.Row="1"
                       Grid.Column="1"
                       Grid.ColumnSpan="3"
                       x:Name="AiEndpointTextBox"
                       Margin="0,10,0,0"
                       Height="32"
                       VerticalContentAlignment="Center"
                       Text="http://localhost:11434/api/chat" />

              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,10,0,0" Text="API key" VerticalAlignment="Center" />
              <PasswordBox Grid.Row="2"
                           Grid.Column="1"
                           x:Name="AiApiKeyPasswordBox"
                           Margin="0,10,0,0"
                           Height="32" />
              <TextBlock Grid.Row="2" Grid.Column="2" Margin="14,10,0,0" Text="Glossary" VerticalAlignment="Center" />
              <TextBox Grid.Row="2"
                       Grid.Column="3"
                       x:Name="AiGlossaryTextBox"
                       Margin="0,10,0,0"
                       Height="32"
                       VerticalContentAlignment="Center"
                       Text="JLPT, N1, N2, N3, N4, N5, 文法, あげもらい, 受け身, 使役受け身, 自動詞, 他動詞, 尊敬語, 謙譲語, 敬語" />
            </Grid>
            <TextBlock Margin="0,8,0,0"
                       Foreground="#596275"
                       TextWrapping="Wrap"
                       Text="AI chỉ sửa file TXT và tạo thêm file .ai.txt; SRT/VTT gốc vẫn giữ nguyên từ Whisper." />
          </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,24,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ProgressBar x:Name="ProgressBar"
                       Height="10"
                       IsIndeterminate="False"
                       Minimum="0"
                       Maximum="100" />
          <TextBox x:Name="StatusTextBox"
                   Grid.Row="1"
                   Margin="0,14,0,0"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas"
                   FontSize="13"
                   Background="#FAFBFC"
                   BorderBrush="#D8DEE9" />
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterText"
                 VerticalAlignment="Center"
                 Foreground="#596275"
                 Text="Kéo file vào cửa sổ để chọn nhanh." />
      <Button Grid.Column="1"
              x:Name="CancelButton"
              Width="110"
              Height="38"
              Margin="0,0,10,0"
              Content="Hủy"
              IsEnabled="False"
              Click="CancelButton_Click" />
      <Button Grid.Column="2"
              x:Name="StartButton"
              Width="130"
              Height="38"
              Content="Bắt đầu"
              Click="StartButton_Click" />
    </Grid>
  </Grid>
</Window>
